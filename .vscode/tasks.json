{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run: current python file",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "clear": true
      }
    },
    {
      "label": "tensorboard: start",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "tensorboard.main",
        "--logdir",
        "${workspaceFolder}/logs",
        "--port",
        "6006"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
